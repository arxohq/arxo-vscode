{
  "information_for_contributors": [
    "Markdown injection: highlighting for law blocks in literate .law.md (SPEC §7.1, §217).",
    "The open/close condition matches the compiler's extraction",
    "(engines/lawc/crates/law-syntax/src/literate.rs): exactly three backticks, info-string",
    "'law' exactly, closing — a ``` line. Blocks the compiler does not pick up",
    "must not look like law code."
  ],
  "scopeName": "markdown.law.codeblock",
  "injectionSelector": "L:text.html.markdown",
  "patterns": [
    {
      "include": "#law-fenced-code-block"
    }
  ],
  "repository": {
    "law-fenced-code-block": {
      "name": "markup.fenced_code.block.markdown",
      "begin": "(^|\\G)(\\s*)(```)(law)([ \\t]+[^\\n]*)?$",
      "beginCaptures": {
        "3": {
          "name": "punctuation.definition.markdown"
        },
        "4": {
          "name": "fenced_code.block.language.markdown"
        },
        "5": {
          "name": "fenced_code.block.language.attributes.markdown"
        }
      },
      "end": "(^|\\G)(\\s*)(```)\\s*$",
      "endCaptures": {
        "3": {
          "name": "punctuation.definition.markdown"
        }
      },
      "patterns": [
        {
          "begin": "(^|\\G)(\\s*)(.*)",
          "while": "(^|\\G)(?!\\s*(```)\\s*$)",
          "contentName": "meta.embedded.block.law",
          "patterns": [
            {
              "include": "source.law"
            }
          ]
        }
      ]
    }
  }
}
