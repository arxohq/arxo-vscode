{
  "information_for_contributors": [
    "Markdown injection: highlighting for ```lawq blocks in documentation (docs/authoring/reference/authoring/QL-COOKBOOK.ru.md",
    "and package notes). The compiler does not pick up these blocks — this is highlighting only,",
    "the block condition mirrors the law injection: exactly three backticks, info-string 'lawq'."
  ],
  "scopeName": "markdown.lawq.codeblock",
  "injectionSelector": "L:text.html.markdown",
  "patterns": [
    {
      "include": "#lawq-fenced-code-block"
    }
  ],
  "repository": {
    "lawq-fenced-code-block": {
      "name": "markup.fenced_code.block.markdown",
      "begin": "(^|\\G)(\\s*)(```)(lawq)([ \\t]+[^\\n]*)?$",
      "beginCaptures": {
        "3": {
          "name": "punctuation.definition.markdown"
        },
        "4": {
          "name": "fenced_code.block.language.markdown"
        },
        "5": {
          "name": "fenced_code.block.language.attributes.markdown"
        }
      },
      "end": "(^|\\G)(\\s*)(```)\\s*$",
      "endCaptures": {
        "3": {
          "name": "punctuation.definition.markdown"
        }
      },
      "patterns": [
        {
          "begin": "(^|\\G)(\\s*)(.*)",
          "while": "(^|\\G)(?!\\s*(```)\\s*$)",
          "contentName": "meta.embedded.block.lawq",
          "patterns": [
            {
              "include": "source.lawq"
            }
          ]
        }
      ]
    }
  }
}
